# Copy to .env and fill in real values. Never commit .env.

# Django
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=app.config.settings.dev

# Database
DATABASE_URL=postgres://app:app@db:5432/llm_portrait
DB_NAME=llm_portrait
DB_USER=app
DB_PASSWORD=app

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# Ollama / LLM
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# Email (dev: Mailhog)
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=noreply@llm-portrait.local

# Throttling
LLM_RATE_LIMIT=3/h

# CORS (comma-separated list of allowed frontend origins)
CORS_ALLOWED_ORIGINS=

# Logging — loguru
# LOG_LEVEL: TRACE | DEBUG | INFO | WARNING | ERROR | CRITICAL
# LOG_FORMAT: human (colored, dev) | json (one record per line, prod)
LOG_LEVEL=INFO
LOG_FORMAT=human
