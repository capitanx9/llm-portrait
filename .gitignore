# Python
__pycache__/
*.py[cod]
*.egg-info/
.Python

# Virtual environments
.venv/

# Environment & secrets
.env
.env.*
!.env.example

# Django
*.log
db.sqlite3
media/
staticfiles/

# Celery
celerybeat-schedule
celerybeat.pid

# Testing & coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Linting & type checking
.ruff_cache/
.mypy_cache/

# VS Code: ignore everything except shared workspace settings (launch.json
# for the debugger config, extensions.json for recommended extensions).
.vscode/*
!.vscode/launch.json
!.vscode/extensions.json

# macOS
.DS_Store

# Intermediate AsyncAPI generator output (we keep only the final HTML).
docs/api/ws/_asyncapi-out/

# Postman CLI's "Local View" scaffolding — we don't use it; the canonical
# collection + envs live in docs/api/ws/postman/ as plain JSON exports.
.postman/
/postman/
