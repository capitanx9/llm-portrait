{
  "info": {
    "_postman_id": "8a3f5e10-2c4b-4d1e-9b27-7c4f5e8d9a01",
    "name": "LLM-Portrait-REST",
    "description": "REST collection for the LLM-Portrait project. Pair with one of the environments under `docs/api/ws/postman/` (the env vars are shared with the WS collection — `base_http` is what this collection uses).\n\nRun order: **Register** (one-time, idempotent) → **Login** (writes `access_token` into a collection variable) → any of the **AI / chat** requests (auth header is wired automatically).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "username", "value": "alice" },
    { "key": "password", "value": "password123" },
    { "key": "access_token", "value": "" },
    { "key": "room", "value": "general" }
  ],
  "item": [
    {
      "name": "Register (one-time)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"{{username}}\",\n    \"email\": \"{{username}}@example.com\",\n    \"password\": \"{{password}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{base_http}}/api/auth/register/"
      },
      "response": []
    },
    {
      "name": "Login (get JWT)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login returns access token\", () => {",
              "    const json = pm.response.json();",
              "    pm.expect(json.access).to.be.a(\"string\");",
              "    pm.collectionVariables.set(\"access_token\", json.access);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"{{username}}\",\n    \"password\": \"{{password}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{base_http}}/api/auth/login/"
      },
      "response": []
    },
    {
      "name": "Me (whoami)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "url": "{{base_http}}/api/auth/me/"
      },
      "response": []
    },
    {
      "name": "AI · translate (ru → en)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"action\": \"translate\",\n    \"message\": \"Привет, как дела?\",\n    \"target_language\": \"en\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{base_http}}/api/ai/process/"
      },
      "response": []
    },
    {
      "name": "AI · translate (en → fr)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"action\": \"translate\",\n    \"message\": \"Hello, how are you?\",\n    \"target_language\": \"fr\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{base_http}}/api/ai/process/"
      },
      "response": []
    },
    {
      "name": "AI · summarize",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"action\": \"summarize\",\n    \"conversation\": [\n        {\"role\": \"user\", \"content\": \"Hi there\"},\n        {\"role\": \"assistant\", \"content\": \"Hello! How can I help today?\"},\n        {\"role\": \"user\", \"content\": \"I want to learn Django\"},\n        {\"role\": \"assistant\", \"content\": \"Great choice. Start with the official tutorial.\"}\n    ]\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{base_http}}/api/ai/process/"
      },
      "response": []
    },
    {
      "name": "AI · 400 missing target_language",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"action\": \"translate\",\n    \"message\": \"Hi\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{base_http}}/api/ai/process/"
      },
      "response": []
    },
    {
      "name": "AI · 400 unknown action",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"action\": \"transmogrify\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{base_http}}/api/ai/process/"
      },
      "response": []
    },
    {
      "name": "AI · 401 no token",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"action\": \"translate\",\n    \"message\": \"Hi\",\n    \"target_language\": \"fr\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{base_http}}/api/ai/process/"
      },
      "response": []
    }
  ]
}
