meta {
  name: Register (one-time)
  type: http
  seq: 1
}

post {
  url: {{base_http}}/api/auth/register/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "{{username}}",
    "email": "{{username}}@example.com",
    "password": "{{password}}"
  }
}
